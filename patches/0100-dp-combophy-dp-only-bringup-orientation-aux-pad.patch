+/* AUX data polarity follows cable orientation.
+ *
+ * UM V0.92 §18.2.6.14, AUX_HPD_PHY_PINS_CTRL2 (0x1e08):
+ *
+ *   bit 29  AUX_DATA_OUT_POLAR_SEL  1: polarity of AUX data out to the DP
+ *                                      controller through the AUX PHY inverted
+ *   bit 28  AUX_DATA_IN_POLAR_SEL   1: polarity of AUX data in from the DP
+ *                                      controller through the AUX PHY inverted
+ *
+ * AUX rides SBU1/SBU2, and USB-C swaps those two pins when the plug is
+ * flipped. So on a reversed cable AUX+ and AUX- arrive transposed and the
+ * whole differential pair is inverted end to end.
+ *
+ * The board handles the DC side of that: phy_switcher's aux_p/aux_n GPIOs
+ * swap which line is biased up and which down. Nothing handles the DATA side.
+ * The vendor writes 0x1e08 as a flat zero, which hardcodes normal polarity,
+ * so with a reversed plug the sink receives Manchester-coded requests with
+ * every symbol inverted, decodes nothing valid, and never replies — while
+ * every status bit the driver can see still reports a healthy, locked link.
+ * That is exactly the observed failure, and it is why AUX_REPLY_CLOCK_WIDTH
+ * reads 0: not a malformed reply, no reply at all.
+ *
+ * Invert both directions when the plug is reversed. Both, because the pair is
+ * physically transposed in both directions, not just on transmit.
+ *
+ * Orientation lives on combo0, not here — the aux-hpd PHY is a separate
+ * instance — so reach it through the shared sunxi_cadence_phy. Callers hold
+ * aux_phy->phy_lock.
+ */
+static void aux_hpd_apply_aux_polarity(struct sunxi_cadence_combophy *aux_phy)
+{
+	struct sunxi_cadence_phy *sunxi_cphy = aux_phy->sunxi_cphy;
+	enum typec_orientation orientation = TYPEC_ORIENTATION_NORMAL;
+	u32 invert;
+
+	if (sunxi_cphy && sunxi_cphy->combo0)
+		orientation = sunxi_cphy->combo0->orientation;
+
+	invert = (orientation == TYPEC_ORIENTATION_REVERSE) ? 0x1 : 0x0;
+
+	phy_set_lbits(aux_phy->top_reg + 0x08, 29, 1, invert);
+	phy_set_lbits(aux_phy->top_reg + 0x08, 28, 1, invert);
+}
+
 static int sunxi_cadence_aux_hpd_power_on(struct phy *phy)
 {
 	struct sunxi_cadence_combophy *aux_phy = phy_get_drvdata(phy);
@@ -3853,21 +3961,99 @@
 
 	phy_set_lbits(aux_phy->top_reg + 0x04, 28, 1, 0x0);
 	phy_set_lbits(aux_phy->top_reg + 0x04, 24, 1, 0x0);
-	phy_set_lbits(aux_phy->top_reg + 0x04, 16, 1, 0x1);
+	/* AUX_HPD_PHY_PINS_CTRL1 bits 23:16 are ATBSEL, a one-hot analog test-bus
+	 * select whose reset value is 0. 0x1 taps "AUX receiver diff pair source
+	 * voltage" onto the analog test bus (UM V0.92 §18.2.6.13). The vendor set
+	 * it to 0x1 unconditionally, i.e. the test bus is hanging off the AUX
+	 * receiver's differential pair during mission mode. Leave it at the
+	 * documented default so nothing is loading the RX pair. */
+	phy_set_lbits(aux_phy->top_reg + 0x04, 16, 1, 0x0);
 	phy_set_lbits(aux_phy->top_reg + 0x04, 8, 5, 0xe);
 	phy_set_lbits(aux_phy->top_reg + 0x04, 0, 5, 0xd);
 
 	phy_writel(aux_phy->top_reg + 0x08, 0);
 
+	/* ...then re-apply AUX data polarity for the current cable orientation.
+	 * The write above clears bits 29/28, which is only correct for a normally
+	 * oriented plug. See aux_hpd_apply_aux_polarity(). */
+	aux_hpd_apply_aux_polarity(aux_phy);
+
 	phy_set_lbits(aux_phy->top_reg + 0x00, 4, 1, 0x1);
 	phy_set_lbits(aux_phy->top_reg + 0x00, 5, 1, 0x1);
 	phy_set_lbits(aux_phy->top_reg + 0x00, 0, 1, 0x1);
 
+	/* Park the pad in receive. AUX is half-duplex and CFG_AUX_TX_DIRECTION
+	 * (bit 9) picks which half is enabled; the AUX engine in the DP
+	 * controller drives it per transaction via ->set_mode below. The vendor
+	 * never wrote bit 9 at all, so the pad sat receive-only forever and no
+	 * request was ever physically driven onto SBU. Write it explicitly rather
+	 * than relying on the reset value. */
+	phy_set_lbits(aux_phy->top_reg + 0x00, 9, 1, 0x0);
+
 	mutex_unlock(&aux_phy->phy_lock);
 
 	return 0;
 }
 
+/* AUX pad direction, half-duplex.
+ *
+ * UM V0.92 §18.2.6.12, AUX_HPD_PHY_PINS_CTRL0 (0x1e00):
+ *
+ *   bit 9  CFG_AUX_TX_DIRECTION  0: enable AUX RX_EN, disable AUX TX_EN
+ *                                1: enable AUX TX_EN, disable AUX RX_EN
+ *   bit 8  CFG_AUX_EN            1: enable TX_EN/RX_EN per CFG_AUX_TX_DIRECTION
+ *
+ * The DP AUX engine has no idea this pad exists, so the controller driver has
+ * to flip the direction around each transaction: TX while the request shifts
+ * out, RX before the sink's reply lands. Exposed as a phy ->set_mode so the
+ * eDP side can drive it through the phy API rather than mapping our registers.
+ *
+ * submode: 0 = receive, 1 = transmit.
+ */
+static int sunxi_cadence_aux_hpd_set_mode(struct phy *phy, enum phy_mode mode,
+					  int submode)
+{
+	struct sunxi_cadence_combophy *aux_phy = phy_get_drvdata(phy);
+
+	if (mode != PHY_MODE_DP)
+		return -EINVAL;
+
+	mutex_lock(&aux_phy->phy_lock);
+	phy_set_lbits(aux_phy->top_reg + 0x00, 9, 1, submode ? 0x1 : 0x0);
+	mutex_unlock(&aux_phy->phy_lock);
+
+	return 0;
+}
+
+/* Direct AUX pad direction control, for the DP controller's AUX engine.
+ *
+ * The eDP side needs to flip this on every transaction, and going through
+ * phy_set_mode_ext() puts the generic PHY core's per-phy mutex in that path.
+ * This is the same register write without that indirection, so the AUX
+ * request path cannot be silently short-circuited by the PHY core.
+ *
+ * Returns the register value read back, so the caller can verify the write
+ * actually landed, or a negative errno.
+ */
+int sunxi_cadence_aux_set_tx_direction(struct phy *phy, bool transmit)
+{
+	struct sunxi_cadence_combophy *aux_phy;
+	u32 val;
+
+	if (!phy)
+		return -EINVAL;
+
+	aux_phy = phy_get_drvdata(phy);
+	if (!aux_phy || !aux_phy->top_reg)
+		return -ENODEV;
+
+	phy_set_lbits(aux_phy->top_reg + 0x00, 9, 1, transmit ? 0x1 : 0x0);
+	val = readl(aux_phy->top_reg + 0x00);
+
+	return (int)(val & 0xffff);
+}
+EXPORT_SYMBOL_GPL(sunxi_cadence_aux_set_tx_direction);
+
 static int sunxi_cadence_aux_hpd_power_off(struct phy *phy)
 {
 	return 0;
@@ -3917,6 +4103,7 @@
 	.power_off	= sunxi_cadence_aux_hpd_power_off,
 	.init		= sunxi_cadence_aux_hpd_init,
 	.exit		= sunxi_cadence_aux_hpd_exit,
+	.set_mode	= sunxi_cadence_aux_hpd_set_mode,
 	.owner		= THIS_MODULE,
 };
 
