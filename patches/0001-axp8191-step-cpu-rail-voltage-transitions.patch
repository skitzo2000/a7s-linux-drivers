 			0x1d, AXP8191_DC1OUT_VOL, GENMASK(4, 0),
 			AXP8191_DCDC_CTL1, BIT(0)),
-	AXP_DESC_RANGES_VOL_DELAY
+	AXP_DESC_RANGES_VOL_STEPPED
 			(AXP8191, DCDC2, "dcdc2", "vin-ps", axp8191_dcdc2_ranges,
 			0x58, AXP8191_DC2OUT_VOL, GENMASK(6, 0),
