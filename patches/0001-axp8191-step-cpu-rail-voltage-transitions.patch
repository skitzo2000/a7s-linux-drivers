regulator: axp2101: step the AXP8191 CPU-rail voltage transitions

The A733 resets under load when cpufreq changes frequency. Not at any
particular frequency or voltage — pin the clock anywhere and the board is
solid — but the transition itself takes it down in minutes under ondemand.

The AXP8191's CPU rails (dcdc2/3/4) go through AXP_DESC_RANGES_VOL_DELAY,
which writes the new selector in one shot. On this board that's jumps of up
to 250 mV (800 -> 1050 mV on the A76 rail) in a single write, and the rail
glitches on the way. The driver already has a stepped-DVM path for exactly
this problem, but it's gated behind CONFIG_AW_AXP1530_WORKAROUND_DVM and the
AXP8191 descriptors never used it.

This adds axp8191_cpu_set_voltage_sel_stepped: ramp UP-transitions ~50 mV at
a time with a 250 us settle between steps, write DOWN-transitions directly
since they can't undervolt. dcdc2/3/4 move onto it.

Verified on a Radxa Cubie A7S, 6.18.19-edge-sun60iw2: 10-minute soak of
ondemand + full 8-core load + 2 GHz + crossing the 60 C passive trip, so both
governor and thermal transitions firing continuously. Zero resets, zero Oops.
The stock kernel does not survive that for two minutes.

Applies to the Allwinner BSP overlay tree (radxa/allwinner-bsp, branch
linux-6.18.x) at its root. The regulator is CONFIG_AW_REGULATOR_AXP2101=y,
so this needs a full Image rebuild — it is not a module.

--- a/drivers/power/regulator/axp2101-regulator.c
+++ b/drivers/power/regulator/axp2101-regulator.c
@@ -16,6 +16,7 @@
 
 #include "sunxi-power-regulator.h"
 #include "axp2101.h"
+#include <linux/delay.h>
 
 #define CPUX_GPIO	0
 #define CPUS_GPIO	1
@@ -149,6 +150,28 @@
 		.ops		= &axp20x_ops_range_vol_delay,			\
 	}
 
+/* Same as AXP_DESC_RANGES_VOL_DELAY but ramps big voltage jumps in small steps
+ * (A7S sun60iw2 DVFS-transition fix) — used for the AXP8191 CPU rails. */
+#define AXP_DESC_RANGES_VOL_STEPPED(_family, _id, _match, _supply, _ranges, _n_voltages,	\
+			_vreg, _vmask, _ereg, _emask)				\
+	[_family##_##_id] = {							\
+		.name		= (_match),					\
+		.supply_name	= (_supply),					\
+		.of_match	= of_match_ptr(_match),				\
+		.regulators_node = of_match_ptr("regulators"),			\
+		.type		= REGULATOR_VOLTAGE,				\
+		.id		= _family##_##_id,				\
+		.n_voltages	= (_n_voltages),				\
+		.owner		= THIS_MODULE,					\
+		.vsel_reg	= (_vreg),					\
+		.vsel_mask	= (_vmask),					\
+		.enable_reg	= (_ereg),					\
+		.enable_mask	= (_emask),					\
+		.linear_ranges	= (_ranges),					\
+		.n_linear_ranges = ARRAY_SIZE(_ranges),				\
+		.ops		= &axp8191_cpu_stepped_ops,			\
+	}
+
 #if IS_ENABLED(CONFIG_AW_AXP1530_WORKAROUND_DVM)
 #define AXP1530_SW_DVM_REGULATOR_RANGE_STEP_DELAY(_family, _id, _match, _supply, _ranges, _n_voltages,	\
 			_vreg, _vmask, _ereg, _emask)						\
@@ -545,6 +568,47 @@
 	.set_voltage_time       = axp_set_voltage_time,
 };
 
+/*
+ * A7S / sun60iw2 DVFS-transition fix: the AXP8191 CPU rails (dcdc2/3/4) hard-reset
+ * the SoC on large single-step voltage jumps during cpufreq transitions (transient
+ * undervolt/rail glitch, only bites under load current). Ramp big UP-transitions in
+ * small steps so the rail settles; DOWN-transitions can't undervolt so write directly.
+ */
+static int axp8191_cpu_set_voltage_sel_stepped(struct regulator_dev *rdev,
+					       unsigned int sel)
+{
+	const unsigned int step = 5;	/* ~50 mV per step (10 mV/selector) */
+	int old_sel, ret;
+	unsigned int cur;
+
+	old_sel = regulator_get_voltage_sel_regmap(rdev);
+	if (old_sel < 0)
+		return regulator_set_voltage_sel_regmap(rdev, sel);
+
+	if (sel <= (unsigned int)old_sel)
+		return regulator_set_voltage_sel_regmap(rdev, sel);
+
+	cur = old_sel;
+	while (cur < sel) {
+		cur = (cur + step < sel) ? cur + step : sel;
+		ret = regulator_set_voltage_sel_regmap(rdev, cur);
+		if (ret)
+			return ret;
+		udelay(250);		/* settle: >= ramp of 50 mV @ 250 uV/us */
+	}
+	return 0;
+}
+
+static struct regulator_ops axp8191_cpu_stepped_ops = {
+	.set_voltage_sel	= axp8191_cpu_set_voltage_sel_stepped,
+	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
+	.list_voltage		= regulator_list_voltage_linear_range,
+	.enable			= regulator_enable_regmap,
+	.disable		= regulator_disable_regmap,
+	.is_enabled		= regulator_is_enabled_regmap,
+	.set_voltage_time	= axp_set_voltage_time,
+};
+
 static struct regulator_ops axp20x_ops = {
 	.set_voltage_sel	= regulator_set_voltage_sel_regmap,
 	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
@@ -1319,15 +1383,15 @@
